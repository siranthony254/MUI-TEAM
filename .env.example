NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Project Settings -> API -> service_role. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:3001

# --- Reminders & delivery (each channel switches on only when its keys are set) ---
# Shared secret the scheduler sends as "Authorization: Bearer <secret>" to /api/cron/dispatch
CRON_SECRET=
# Web push: generate with `npx web-push generate-vapid-keys`
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.org
# Email via Resend (https://resend.com) - EMAIL_FROM must be on a verified domain
RESEND_API_KEY=
EMAIL_FROM=MUI Team <team@yourdomain.org>
# SMS via Africa's Talking (AT_USERNAME=sandbox to test)
AT_USERNAME=
AT_API_KEY=
AT_SENDER_ID=
